# Copy to .env (git-ignored) and fill in. The backend reads .env from the project root or backend folder.
# Generate each 256-bit key with PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

DB_URL=jdbc:postgresql://localhost:5433/taxpilot
DB_USER=taxpilot
DB_PASSWORD=taxpilot_dev_only

TAXPILOT_JWT_SECRET=<base64 32 bytes>
TAXPILOT_ENCRYPTION_KEY=<base64 32 bytes>   # encrypts PAN, bank numbers and stored files - losing it loses that data
TAXPILOT_HMAC_KEY=<base64 32 bytes>

# false only for local http://localhost
TAXPILOT_COOKIE_SECURE=false

# local | s3
TAXPILOT_STORAGE_TYPE=local
TAXPILOT_STORAGE_PATH=../data/documents
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=taxpilot-documents
# S3_ACCESS_KEY=taxpilot
# S3_SECRET_KEY=taxpilot_dev_only

# true requires ClamAV (docker compose --profile scan up -d)
TAXPILOT_SCAN_ENABLED=false

# First administrator, created only when no users exist. Must change password at first login.
TAXPILOT_ADMIN_EMAIL=admin@taxpilot.local
TAXPILOT_ADMIN_NAME=System Administrator
TAXPILOT_ADMIN_PASSWORD=<12+ chars with upper, lower and a digit>
